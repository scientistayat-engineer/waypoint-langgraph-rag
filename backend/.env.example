# Copy this file to backend/.env and fill in your values.

# Get a free key at https://console.groq.com/keys
# Leave empty to type the key into the web app instead (it is kept in your browser).
GROQ_API_KEY=

# Model and embeddings
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Passages retrieved per question (1 to 10)
TOP_K=2

# Best match below this score reroutes the question to the fallback node
MIN_SCORE=0.15

# Optional: trace every run in LangSmith (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=waypoint

# huggingface = local MiniLM embeddings (needs PyTorch); keyword = lightweight search, no PyTorch
EMBEDDING_BACKEND=huggingface

# true = no API key, no model download (keyword search and a tiny extractive answerer)
DEMO_MODE=false

# Comma-separated origins allowed to call the API when the frontend is hosted elsewhere
CORS_ORIGINS=*
